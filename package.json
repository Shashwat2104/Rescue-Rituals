{
  "name": "events-api",
  "version": "1.0.0",
  "description": "Events Management API MVP - NestJS (JavaScript) + PostgreSQL + Sequelize + JWT",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "start": "cross-env SWCRC=true node -r @swc-node/register src/main.js",
    "start:dev": "cross-env SWCRC=true node -r @swc-node/register src/main.js",
    "build": "swc src -d dist --copy-files --config-file .swcrc",
    "start:prod": "node dist/main.js",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo:all",
    "db:create": "sequelize-cli db:create",
    "db:drop": "sequelize-cli db:drop",
    "lint": "echo \"(no linter configured for MVP)\" && exit 0"
  },
  "dependencies": {
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^3.1.1",
    "@nestjs/core": "^10.3.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/swagger": "^7.3.0",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "dotenv": "^16.3.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.11.3",
    "pg-hstore": "^2.3.4",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1",
    "sequelize": "^6.35.2",
    "sequelize-cli": "^6.6.2"
  },
  "devDependencies": {
    "@swc-node/register": "^1.10.0",
    "@swc/cli": "^0.4.0",
    "@swc/core": "^1.7.0",
    "@swc/jest": "^0.2.36",
    "cross-env": "^10.1.0",
    "jest": "^29.7.0",
    "supertest": "^6.3.3"
  },
  "jest": {
    "rootDir": ".",
    "testRegex": "src/.*\\.spec\\.js$",
    "transform": {
      "^.+\\.js$": [
        "@swc/jest",
        {
          "jsc": {
            "parser": {
              "syntax": "ecmascript",
              "decorators": true,
              "dynamicImport": true
            },
            "transform": {
              "legacyDecorator": true,
              "decoratorMetadata": true
            },
            "target": "es2022"
          },
          "module": {
            "type": "commonjs"
          },
          "sourceMaps": true
        }
      ]
    },
    "testEnvironment": "node",
    "moduleFileExtensions": [
      "js",
      "json"
    ]
  }
}
